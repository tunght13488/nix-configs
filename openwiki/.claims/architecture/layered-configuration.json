    {
      "id": "claim_c564375ab37546e48d5af24e37aefc10",
      "statement": "`home-manager/home.nix` owns the `tung` user profile and imports personal feature files alongside reusable Home Manager modules and external modules; it configures user packages, home identity, session behavior, and activation/state-version settings.",
