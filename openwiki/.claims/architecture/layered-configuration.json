    {
      "id": "claim_39e7380ffc92448abe1a90d775b98d20",
      "statement": "The flake exposes two independently evaluated configuration products: the NixOS system `nixos-vmware` and standalone Home Manager profile `tung@nixos-vmware`; each has its own package set, overlays, and module list, so applying one does not apply the other.",
      "evidence": [
        {
          "resource": "repo://flake.nix#L162-L186",
          "version": "repo-lines-v1:sha256:f12aa843541ed1918e6fbad33303e5123aa63102ac8c192ac03b9628854df177:"
