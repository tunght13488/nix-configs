        }
      ]
    },
    {
      "id": "claim_9d4f7084653d4c729316de8555ecf68d",
      "statement": "`nixos/configuration.nix` is the host composition point: it imports generated hardware state and host-specific VMware, PHP-FPM, Nginx, local-development, MySQL, and Nix-ld modules, while owning machine-wide system policy and packages.",
