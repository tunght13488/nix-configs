    {
      "id": "claim_fc461ea0a86c4b7aa9169f3b9f5d6dc3",
      "statement": "`nixos/hardware-configuration.nix` is generated hardware state imported by the host configuration and contains hardware-derived boot, filesystem, swap, kernel-module, and platform settings; it should be changed for hardware-driven updates rather than application or user policy.",
